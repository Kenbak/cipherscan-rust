# NOTE: This unit runs as root for internal deployments. For production use,
# create a dedicated service user and adapt paths accordingly.

[Unit]
Description=CipherScan Rust Indexer (Mainnet)
After=network-online.target postgresql.service zebrad-mainnet.service
Wants=network-online.target zebrad-mainnet.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/cipherscan-rust

EnvironmentFile=/root/cipherscan-rust/.env

# The flock holds an exclusive, non-blocking lock on /run/cipherscan-indexer.lock
# for the lifetime of the indexer process. A second instance of this unit, a
# manually started `cipherscan-indexer live`/`backfill`, or the disabled
# cipherscan-rust-backfill@.service template all contend for the same lock
# file and fail to start instead of writing to PostgreSQL concurrently. This
# is host-level fencing only (see cipherscan-rust-backfill@.service and the
# planned DB-level writer lease for cross-host fencing).
ExecStart=/usr/bin/flock -n /run/cipherscan-indexer.lock /root/cipherscan-rust/target/release/cipherscan-indexer live

Restart=on-failure
RestartSec=30
LimitNOFILE=65536

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cipherscan-rust

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadOnlyPaths=/root/cipherscan-rust

[Install]
WantedBy=multi-user.target
