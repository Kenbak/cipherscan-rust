# DISABLED BY DEFAULT. Do not `systemctl enable` this unit.
#
# Fenced, supervised alternative to running `run-parallel-backfill.sh` (or a
# bare `cipherscan-indexer backfill`) by hand. It exists specifically to
# prevent the class of incident from 2026-07-16, where a stale/edited unit
# invoked `backfill` at the same time another worker was indexing.
#
# Fencing mechanism: ExecStart wraps the binary in `flock -n
# /run/cipherscan-indexer.lock`, the SAME lock file cipherscan-rust.service
# holds for its entire run. If the live unit is active, this unit's flock
# fails immediately (exit 1) and ONLY this unit fails to start — the live
# unit is completely unaffected.
#
# IMPORTANT: do NOT add `Conflicts=cipherscan-rust.service` (or any
# Conflicts= against it) here. systemd's Conflicts= is symmetric: starting a
# unit that conflicts with an active unit causes systemd to STOP the active
# unit as part of the same transaction, before this unit even runs. An
# earlier revision of this file had Conflicts= and, on 2026-08-15, starting
# this template while cipherscan-rust.service was active stopped live
# indexing for ~6 minutes (self-healed with zero missing block heights, but
# it was still an unintended production outage). The flock alone gives the
# correct behavior: the new unit fails, the running one is untouched.
#
# Usage (manual, one-shot; instance name is "<from>-<to>"):
#   systemctl is-active --quiet cipherscan-rust && echo "STOP: live is active" || \
#     systemctl start cipherscan-rust-backfill@3000000-3001000.service
#   journalctl -u cipherscan-rust-backfill@3000000-3001000.service -f
#
# Never enable this unit for boot-time start, and always confirm
# `systemctl is-active cipherscan-rust` is NOT "active" before starting it —
# the flock will refuse to run alongside it, but check first regardless.

[Unit]
Description=CipherScan Rust Indexer - Fenced Backfill (%i) - DISABLED, ad-hoc use only
After=network-online.target postgresql.service zebrad-mainnet.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/cipherscan-rust
EnvironmentFile=/root/cipherscan-rust/.env
ExecStart=/usr/bin/flock -n /run/cipherscan-indexer.lock /bin/bash -c 'IFS="-" read -r from to <<< "%i"; exec /root/cipherscan-rust/target/release/cipherscan-indexer backfill --from "$from" --to "$to"'
Restart=no
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cipherscan-rust-backfill

# Intentionally no [Install] section — this unit must never be `enable`d for
# boot-time start. Start it manually and only when cipherscan-rust.service is
# confirmed stopped.
